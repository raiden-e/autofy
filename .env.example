# autofy secrets template — copy to .env and fill in. .env is gitignored.
# Non-secret defaults (SCOPE, REDIRECT, playlist ids, discord channels) live in config.py.

# --- Spotify (https://developer.spotify.com/dashboard) ---
SPOTIFY_ID=          # client id from the app in the dashboard
SPOTIFY_HASH=        # client secret from the app
SPOTIFY_NAME=        # your spotify username
SPOTIFY_CACHE=       # leave empty; the OAuth token lives in util/spotify.cache
# SPOTIFY_REDIRECT=https://raiden-e.github.io/autofy
# SPOTIFY_LOSTTRACKS=https://open.spotify.com/playlist/<id>

# --- GitHub gist (https://github.com/settings/tokens — scope: gist) ---
GIST_ID=             # the gist id holding autofy.json
GIST_TOKEN=          # fine-grained or classic PAT with gist access

# --- Reddit / PRAW (https://www.reddit.com/prefs/apps) ---
PRAW_ID=
PRAW_TOKEN=

# --- Discord bot (https://discord.com/developers/applications) ---
DISCORD_TOKEN=

# --- Misc APIs ---
TOKEN_ALEXFLIPNOTE=
NEWS_API=
